[Unit]
Description=Hourly Teamleader Orbit time-logging popup

[Timer]
# Fires every hour; the app itself only pops up at the end of your work hours
# (set with `tl-uurtjes setup`), e.g. 10:00 asks about 9-10.
OnCalendar=*-*-* *:00:00
# Fire on wake/boot when a run was missed; the popup then walks through every open hour.
Persistent=true

[Install]
WantedBy=timers.target
